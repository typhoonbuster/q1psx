{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
	"configurePresets": [
		{
			"name":          "default",
			"displayName":   "PSn00bSDK build",
			"generator":     "Ninja",
			"toolchainFile": "$env{PSN00BSDK_LIBS}/cmake/sdk.cmake",
			"binaryDir":     "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"PSN00BSDK_TC":     "",
				"PSN00BSDK_TARGET": "mipsel-none-elf"
			},
			"warnings": { "dev": false }
		},
		{
			"name":          "release",
			"inherits":      "default",
			"displayName":   "Release build: Quake's menu, no debug tools; the high textures, the 3D gun",
			"binaryDir":     "${sourceDir}/build-release",
			"cacheVariables": {
				"Q1PSX_PROFILE":  "OFF",
				"Q1PSX_RELEASE":  "ON",
				"Q1PSX_TEXTURES": "high",
				"Q1PSX_WEAPON":   "3d"
			}
		},
		{
			"name":          "release-medium",
			"inherits":      "release",
			"displayName":   "Release build with the medium textures",
			"binaryDir":     "${sourceDir}/build-release-medium",
			"cacheVariables": {
				"Q1PSX_TEXTURES": "medium"
			}
		},
		{
			"name":          "bench",
			"inherits":      "default",
			"displayName":   "Headless benchmark build (scripts/bench.sh)",
			"binaryDir":     "${sourceDir}/build-bench",
			"cacheVariables": {
				"Q1PSX_BENCH": "ON"
			}
		}
	]
}
