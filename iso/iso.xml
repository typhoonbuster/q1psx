<?xml version="1.0" encoding="utf-8"?>
<!--
	Processed by CMake, consumed by mkpsxiso. Paths are relative to the build
	directory unless prefixed with ${PROJECT_SOURCE_DIR}.

	Cooked Quake assets (the COOKED_ENTRIES slot) come back with the cook
	tool in roadmap step R2. pak0.pak is bundled from local.env (the PAK0_ENTRY
	slot) for now; whether the final disc carries it raw or only cooked data is
	decided in R2.
-->
<iso_project>
	<track type="data">
		<identifiers
			system         ="PLAYSTATION"
			volume         ="Q1PSX"
			volume_set     ="Q1PSX"
			publisher      ="TYPHOONBUSTER"
			data_preparer  ="PSN00BSDK ${PSN00BSDK_VERSION}"
			application    ="PLAYSTATION"
			copyright      ="README.TXT;1"
		/>

		<directory_tree>
			<file name="SYSTEM.CNF" type="data" source="${PROJECT_SOURCE_DIR}/iso/system.cnf" />
			<file name="Q1PSX.EXE"  type="data" source="q1psx.exe" />
			<file name="HELLO.TXT"  type="data" source="${PROJECT_SOURCE_DIR}/iso/hello.txt" />
			@GAME_ENTRY@
			@STREAM_ENTRY@
			<!-- the music (read while the game runs: next to the streamed assets) -->
			<dir name="MUSIC">
			@MUSIC_ENTRIES@
			</dir>
			@PAK0_ENTRY@
			<!-- in a subdirectory: the BIOS only reads the root directory's first
			     sector, and SYSTEM.CNF must stay in it -->
			<dir name="MAPS">
			@COOKED_ENTRIES@
			</dir>

			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
