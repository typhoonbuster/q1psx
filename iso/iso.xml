<?xml version="1.0" encoding="utf-8"?>
<!--
	Processed by CMake (scripts/cd_image.cmake, at the build, after the
	cook), consumed by mkpsxiso. Paths are relative to the build directory
	unless prefixed with ${PROJECT_SOURCE_DIR}. mkpsxiso lays the files out
	in this order: the disc's layout is the order below (docs/porting-notes.md
	§84).
-->
<iso_project>
	<track type="data">
		<identifiers
			system         ="PLAYSTATION"
			volume         ="Q1PSX"
			volume_set     ="Q1PSX"
			publisher      ="TYPHOONBUSTER"
			data_preparer  ="PSN00BSDK ${PSN00BSDK_VERSION}"
			application    ="PLAYSTATION"
			copyright      ="README.TXT;1"
		/>

		<directory_tree>
			<file name="SYSTEM.CNF" type="data" source="${PROJECT_SOURCE_DIR}/iso/system.cnf" />
			<file name="Q1PSX.EXE"  type="data" source="q1psx.exe" />
			<file name="HELLO.TXT"  type="data" source="${PROJECT_SOURCE_DIR}/iso/hello.txt" />
			<!-- the root's: the game data, the console's background, the pool of
			     streamed assets (its directory read at boot), the menu's bank -->
			@ROOT_ENTRIES@
			@PAK0_ENTRY@
			<!-- one directory a level under LVL (the BIOS only reads the root
			     directory's first sector, where SYSTEM.CNF and the executable must
			     stay: 32 more records in the root pushed them to its second): its
			     files in the order its load reads them, what the game reads in
			     play right before its copy of its music track -->
			<dir name="LVL">
			@LEVEL_DIRS@
			</dir>
			<!-- the music played where nothing much is loaded, once: the title's
			     track and the intermission's -->
			<dir name="MUSIC">
			@MUSIC_ENTRIES@
			</dir>

			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
